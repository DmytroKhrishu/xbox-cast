# Copy to .env (gitignored). Dev tools in tools/ read it; real environment variables win.
# Xbox in Dev Mode (Device Portal at https://XBOX_HOST:11443, app dev server at http://XBOX_HOST:7099)
XBOX_HOST=<xbox-lan-ip>
# file containing "user:pass" for the Device Portal
XBOX_PORTAL_CRED_FILE=~/.config/xbox-devportal.cred
# owner/repo for CI artifacts (default: gh repo view)
GITHUB_REPOSITORY=
